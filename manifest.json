{
  "manifest_version": 3,
  "name": "ShortBlock",
  "version": "0.3.0",
  "description": "Your friendly neighbourhood Shorts and Reels blocker.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ShortBlock",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["Youtube/youtube.js"],
      "css": ["Youtube/youtube.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["Instagram/insta.js"],
      "css": ["Instagram/insta.css"],
      "run_at": "document_start"
    }
  ]
}