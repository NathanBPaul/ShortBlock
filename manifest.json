{
  "manifest_version": 3,
  "name": "ShortBlock",
  "version": "0.1.0",
  "description": "Stop short-maxing with a five-second cooldown.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ]
}