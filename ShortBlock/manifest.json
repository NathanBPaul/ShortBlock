{
  "manifest_version": 3,
  "name": "ShortBlock",
  "version": "0.1.0",
  "description": "Stop short-maxing with a five-second cooldown.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ]
}